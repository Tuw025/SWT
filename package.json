{
  "name": "date-time-checker-testing",
  "version": "1.3.0",
  "private": true,
  "description": "API, browser E2E, visual and performance exercises for Date Time Checker",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --project=api --project=web-chromium",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=web-chromium",
    "test:e2e:headed": "playwright test --project=web-chromium --headed",
    "test:e2e:ui": "playwright test --project=web-chromium --ui",
    "test:e2e:debug": "playwright test --project=web-chromium --debug",
    "test:cross-browser": "playwright test --project=web-chromium --project=web-firefox --project=web-webkit",
    "test:visual": "playwright test --project=visual-chromium",
    "test:visual:update": "playwright test --project=visual-chromium --update-snapshots",
    "test:ui-performance": "playwright test --project=ui-performance-chromium",
    "test:performance": "node ci/run-k6.cjs",
    "report": "playwright show-report reports/playwright",
    "lab:list": "node tools/lab-runner.cjs list",
    "lab:api": "node tools/lab-runner.cjs api",
    "lab:web": "node tools/lab-runner.cjs web",
    "lab:mobile": "node tools/lab-runner.cjs mobile",
    "lab:visual": "node tools/lab-runner.cjs visual",
    "lab:performance": "node tools/lab-runner.cjs performance",
    "lab:report": "node tools/lab-runner.cjs report",
    "lab:menu": "node tools/lab-menu.cjs",
    "lab:ai": "node tools/ai-runner.cjs",
    "ci:local": "node ci/run-pipeline.cjs",
    "ci:topic": "node ci/run-topic.cjs",
    "dashboard": "node tools/dashboard/server.cjs",
    "dashboard:check": "node tools/reporting/verify.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "allure": "3.20.1",
    "fflate": "0.8.2"
  }
}
